{
  "name": "agromet-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "AgroMet monorepo workspace",
  "scripts": {
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:lint": "npm --prefix frontend run lint",
    "backend:dev": "python -m uvicorn backend.app.main:app --reload --app-dir . --port 8000",
    "backend:start": "python -m uvicorn backend.app.main:app --app-dir . --host 0.0.0.0 --port 8000"
  }
}
