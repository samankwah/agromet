# The mobile app lives in its own repository (agromet-mobile). The folder
# stays here so it can sit beside the backend it talks to during
# development, but its history belongs to that repo, not this one.
mobile/

# Raw multi-decade download caches the climatology bakes write to
# backend/app/data/, one per `build_*_climatology.py` script (dot-prefixed
# by convention, e.g. .climatology_cache.json, .s2s_grid_cache.json).
# Regenerable by re-running the relevant script; only the fitted, non-dot
# output (hazard_climatology.json, s2s_climatology.json, ...) is committed.
backend/app/data/.*.json
